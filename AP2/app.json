{
  "expo": {
    "name": "Vice City Motors",
    "slug": "AP2",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vicecitymotors",
    "icon": "./assets/icono-app.png",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002D62",
        "foregroundImage": "./assets/frente-icono-android.png",
        "monochromeImage": "./assets/icono-android-monocromatico.png"
      }
    },
    "web": {
      "favicon": "./assets/icono-web.png",
      "bundler": "metro"
    }
  }
}
